# Program to create and manipulate list using indexing slicing and list comprehensions


numbers = [10, 20, 30, 40, 50, 60]

print("Original List:", numbers)

print("\n--- Indexing ---")
print("First element:", numbers[0])
print("Last element:", numbers[-1])

print("\n--- Slicing ---")
print("First three elements:", numbers[:3])
print("Elements from index 2 to 4:", numbers[2:5])
print("Reversed list:", numbers[::-1])

print("\n--- List Manipulation ---")
numbers.append(70)
print("After append(70):", numbers)

numbers.insert(2, 25)
print("After insert(2, 25):", numbers)

numbers.remove(40)
print("After remove(40):", numbers)

numbers.pop()
print("After pop():", numbers)

print("\n--- List Comprehensions ---")

squares = [x ** 2 for x in numbers]
print("Squares:", squares)

even_numbers = [x for x in numbers if x % 2 == 0]
print("Even Numbers:", even_numbers)

double = [x * 2 for x in numbers]
print("Doubled List:", double)
